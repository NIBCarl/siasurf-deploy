APP_NAME=SiaSurf
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Use your Railway domain, or a custom domain (e.g. https://www.siasurf.online)
APP_URL=https://siasurf-deploy-production.up.railway.app
APP_FORCE_HTTPS=true
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=database

BCRYPT_ROUNDS=12

# Stream logs to stdout/stderr so Railway Deploy Logs capture runtime errors
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Database (Railway MySQL variable references; on a VPS set host/user/db/password directly)
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# Database-backed sessions and cache; use `sync` queue for a single web service,
# or `database` if running a separate Railway Worker / Supervisor queue process.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Use `log` on a single web container, or `reverb` with a dedicated Reverb service
BROADCAST_CONNECTION=log

# Required by Railway Railpack so GD, Zip, MySQL, BCMath, Intl, and PCNTL are compiled
RAILPACK_PHP_EXTENSIONS=gd,zip,pdo_mysql,bcmath,intl,pcntl

# Mail — Railway Hobby blocks outbound SMTP ports (25, 465, 587, 2525), so use
# Resend's HTTPS API (port 443). On a VPS you may alternatively use SMTP.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@siasurf.online"
MAIL_FROM_NAME="SiaSurf"
MAIL_TIMEOUT=15

# ---------------------------------------------------------------------------
# SiaSurf specific
# ---------------------------------------------------------------------------

# Public HTTPS base URL encoded into scannable instructor QR codes
SIASURF_PUBLIC_URL=https://siasurf-deploy-production.up.railway.app

# Payments — leave all keys blank to use MockPaymentService for defense demos
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_MODE=live

# Optional alternative gateway (takes precedence over PayMongo when set)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_CALLBACK_URL=

# Optional: Laravel Reverb WebSockets (only needed when BROADCAST_CONNECTION=reverb)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Vite bakes VITE_* variables into the JS bundle during `npm run build`
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Stormglass.io tide data (free tier: 10 calls/day; cached 48h)
STORMGLASS_API_KEY=

# Keep false on 1-2 GB containers/VMs (ClamAV uses ~1 GB RAM)
VIRUS_SCAN_ENABLED=false
VIRUS_SCAN_BINARY=clamdscan

# Feedback, strikes, and suspensions
SIASURF_AUTO_CONFIRM_REPORTS=false
SIASURF_STANDARD_REVIEW_HOURS=24
SIASURF_CRITICAL_REVIEW_HOURS=4
SIASURF_STRIKE_THRESHOLD=3
SIASURF_SUSPENSION_DAYS=30

# Seeded SISA admin account — change immediately after first login
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
